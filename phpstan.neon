parameters:
    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    level: 6

    paths:
        - resources/views
        - src
        - tests

    scanFiles:
        - %rootDir%/../../../vendor/davidhirtz/yii2-skeleton/Yii.php
